{
  "name": "utils",
  "private": true,
  "workspaces": {
    "packages": [
      "packages/boxes/*",
      "packages/loggers/*",
      "packages/*"
    ]
  },
  "scripts": {
    "build": "npm run build --workspaces",
    "coverage": "npm run coverage --workspaces --if-present",
    "lint": "npm run lint --workspaces",
    "lint:check": "npm run lint:check --workspaces",
    "prepare": "husky install",
    "release": "npm run release --workspaces",
    "test": "npm run test --if-present --workspaces",
    "knip": "npx knip --dependencies",
    "type-check": "npm run type-check --workspaces",
    "version": "npx changeset version && npm i"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.1",
    "@rosen-bridge/changeset-formatter": "^1.0.0",
    "@typescript-eslint/eslint-plugin": "^8.43.0",
    "@typescript-eslint/parser": "^8.43.0",
    "@vitest/eslint-plugin": "^1.3.9",
    "eslint": "^9.35.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-check-file": "^3.2.0",
    "husky": "^8.0.1",
    "knip": "5.54.1",
    "lint-staged": "^13.0.3",
    "prettier": "^3.2.4"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
