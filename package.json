{
  "name": "utils",
  "private": true,
  "workspaces": {
    "packages": [
      "packages/*",
      "packages/address-codec-chains/*",
      "packages/boxes/*",
      "packages/loggers/*"
    ]
  },
  "scripts": {
    "build": "npm run build --workspaces",
    "coverage": "npm run coverage --workspaces --if-present",
    "lint": "npm run lint --workspaces",
    "lint:check": "npm run lint:check --workspaces",
    "madge": "madge --circular --extensions ts ./",
    "prepare": "husky install",
    "release": "npm run release --workspaces",
    "test": "npm run test --if-present --workspaces",
    "type-check": "npm run type-check --workspaces",
    "version": "npx changeset version && npx changeset add --empty && npm i"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.1",
    "@eslint/js": "^9.38.0",
    "@rosen-bridge/changeset-formatter": "^2.0.1",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/node": "^22.18.0",
    "@typescript-eslint/eslint-plugin": "^8.43.0",
    "@typescript-eslint/parser": "^8.43.0",
    "@vitest/coverage-istanbul": "^3.2.4",
    "@vitest/eslint-plugin": "^1.3.9",
    "eslint": "^9.35.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-check-file": "^3.2.0",
    "globals": "^16.4.0",
    "husky": "^8.0.1",
    "knip": "5.54.1",
    "lint-staged": "^13.0.3",
    "madge": "^8.0.0",
    "prettier": "^3.2.4",
    "rimraf": "^6.0.1",
    "tsx": "^4.20.5",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=22.18.0",
    "npm": "11.6.2"
  },
  "dependencies": {
    "cross-env": "^10.1.0"
  }
}
