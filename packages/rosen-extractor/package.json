{
  "name": "@rosen-bridge/rosen-extractor",
  "version": "12.0.2",
  "description": "this project contains methods to get rosen data from blockchain",
  "keywords": [
    "rosen"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rosen-bridge/utils.git"
  },
  "license": "MIT",
  "author": "Rosen Team",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "directories": {
    "lib": "lib",
    "test": "tests"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc --build tsconfig.build.json",
    "coverage": "npm run test -- --coverage",
    "lint": "eslint --fix . && npm run prettify",
    "lint:check": "eslint . && npm run prettify:check",
    "prettify": "prettier --write . --ignore-path ../../.gitignore",
    "prettify:check": "prettier --check . --ignore-path ../../.gitignore",
    "release": "npm run test && npm run build && npm publish --access public",
    "test": "NODE_OPTIONS='--import tsx' vitest",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@bitcoinerlab/secp256k1": "^1.2.0",
    "@blockfrost/openapi": "^0.1.80",
    "@cardano-ogmios/schema": "^6.0.3",
    "@emurgo/cardano-serialization-lib-nodejs": "^13.2.1",
    "@rosen-bridge/abstract-logger": "^4.0.0",
    "@rosen-bridge/address-manager": "^0.1.0",
    "@rosen-bridge/json-bigint": "^1.1.0",
    "@rosen-bridge/tokens": "^6.0.1",
    "bitcoinjs-lib": "^6.1.5",
    "ergo-lib-wasm-nodejs": "^0.24.1",
    "ethers": "6.16.0",
    "lodash-es": "^4.17.21"
  },
  "devDependencies": {
    "@rosen-bridge/address-codec": "^2.0.0",
    "@types/lodash-es": "^4.17.6"
  },
  "engines": {
    "node": ">=22.18.0",
    "npm": "11.6.2"
  }
}
