{
  "name": "@rosen-bridge/rosen-extractor",
  "version": "8.0.1",
  "description": "this project contains methods to get rosen data from blockchain",
  "main": "dist/lib/index.js",
  "types": "dist/lib/index.d.ts",
  "type": "module",
  "scripts": {
    "prettify": "prettier --write . --ignore-path .gitignore",
    "lint": "eslint --fix . && npm run prettify",
    "build": "tsc --build tsconfig.build.json",
    "type-check": "tsc --noEmit",
    "test": "jest --detectOpenHandles --runInBand",
    "coverage": "npm run test -- --coverage",
    "release": "npm run test && npm run build && npm publish --access public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rosen-bridge/utils.git"
  },
  "files": [
    "dist"
  ],
  "license": "GPL-3.0",
  "dependencies": {
    "@bitcoinerlab/secp256k1": "^1.2.0",
    "@blockfrost/blockfrost-js": "^6.0.0",
    "@cardano-ogmios/schema": "^6.0.3",
    "@emurgo/cardano-serialization-lib-nodejs": "^13.2.1",
    "@rosen-bridge/abstract-logger": "^2.0.1",
    "@rosen-bridge/address-codec": "^0.6.3",
    "@rosen-bridge/json-bigint": "^0.1.0",
    "@rosen-bridge/tokens": "^3.1.1",
    "bitcoinjs-lib": "^6.1.5",
    "ergo-lib-wasm-nodejs": "^0.24.1",
    "ethers": "6.13.2",
    "json-bigint": "^1.0.0",
    "lodash-es": "^4.17.21"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.19.0",
    "@types/jest": "^29.1.2",
    "@types/json-bigint": "^1.0.1",
    "@types/lodash-es": "^4.17.6",
    "@types/node": "^20.11.0",
    "jest": "^29.2.0",
    "ts-jest": "^29.0.3",
    "ts-node": "^10.8.1",
    "typescript": "^5.8.3"
  },
  "directories": {
    "lib": "lib",
    "test": "tests"
  },
  "keywords": [
    "rosen"
  ]
}
