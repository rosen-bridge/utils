{
  "name": "@rosen-bridge/winston-logger",
  "version": "1.1.0",
  "description": "Rosen Bridge Winston logger, used inside Rosen services",
  "repository": "https://github.com/rosen-bridge/utils",
  "license": "MIT",
  "author": "Rosen Team",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --build tsconfig.build.json",
    "lint": "eslint --fix . && npm run prettify",
    "lint:check": "eslint . && npm run prettify:check",
    "prettify": "prettier --write . --ignore-path ../../../.gitignore",
    "prettify:check": "prettier --check . --ignore-path ../../../.gitignore",
    "release": "npm run build && npm publish --access public",
    "type-check": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "tsx": "^4.20.5",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "dependencies": {
    "@rosen-bridge/abstract-logger": "^2.1.0",
    "@rosen-bridge/json-bigint": "^0.2.0",
    "winston": "^3.17.0",
    "winston-daily-rotate-file": "^4.7.1",
    "winston-loki": "^6.0.7"
  }
}
