{
  "name": "@rosen-bridge/abstract-logger",
  "version": "3.0.1",
  "description": "Rosen Bridge abstract logger class, the base type for loggers used in all Rosen packages",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rosen-bridge/utils.git"
  },
  "license": "MIT",
  "author": "Rosen Team",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "scripts": {
    "prettify": "prettier --write . --ignore-path ../../../.gitignore",
    "prettify:check": "prettier --check . --ignore-path ../../../.gitignore",
    "lint": "eslint --fix . && npm run prettify",
    "lint:check": "eslint . && npm run prettify:check",
    "build": "tsc --build tsconfig.build.json",
    "type-check": "tsc --noEmit",
    "release": "npm run build && npm publish --access public"
  },
  "directories": {
    "lib": "lib"
  },
  "keywords": [
    "rosen"
  ],
  "engines": {
    "node": ">=22.18.0",
    "npm": "11.6.2"
  }
}
