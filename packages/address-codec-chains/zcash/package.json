{
  "name": "@rosen-bridge/address-codec-zcash",
  "version": "0.0.0",
  "description": "Transparent Zcash P2PKH address codec for Rosen Bridge",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rosen-bridge/utils.git"
  },
  "license": "MIT",
  "author": "Rosen Team",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc --build tsconfig.build.json",
    "lint": "eslint --fix . && npm run prettify",
    "lint:check": "eslint . && npm run prettify:check",
    "prettify": "prettier --write . --ignore-path ../../../.gitignore",
    "prettify:check": "prettier --check . --ignore-path ../../../.gitignore",
    "release": "npm run test && npm run build && npm publish --access public",
    "type-check": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@noble/curves": "1.2.0",
    "@noble/hashes": "1.3.2",
    "bech32": "2.0.0",
    "bs58check": "4.0.0"
  },
  "devDependencies": {
    "@rosen-bridge/address-manager": "^0.1.0"
  },
  "engines": {
    "node": ">=22.18.0",
    "npm": "11.6.2"
  }
}
