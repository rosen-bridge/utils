{
  "name": "@rosen-bridge/address-codec-bitcoin-cash",
  "version": "0.0.0",
  "description": "Bitcoin Cash native mainnet address encoding for Rosen bridge",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rosen-bridge/utils.git",
    "directory": "packages/address-codec-chains/bitcoin-cash"
  },
  "license": "MIT",
  "author": "A. Shannon",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist/**/*.js",
    "dist/**/*.js.map",
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc --build tsconfig.build.json",
    "clean": "rimraf dist && rimraf tsconfig.build.tsbuildinfo",
    "coverage": "npm run test -- --run --coverage",
    "lint": "eslint --fix . && npm run prettify",
    "lint:check": "eslint . && npm run prettify:check",
    "prettify": "prettier --write . --ignore-path ../../../.gitignore",
    "prettify:check": "prettier --check . --ignore-path ../../../.gitignore",
    "release": "npm run test -- --run && npm run build && npm publish --access public",
    "test": "cross-env NODE_OPTIONS=\"--import tsx\" vitest",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@bitauth/libauth": "3.0.0"
  },
  "engines": {
    "node": ">=22.18.0",
    "npm": "11.6.2"
  }
}
