{
  "name": "@rosen-bridge/minimum-fee",
  "version": "3.0.1",
  "description": "this project gets minimum fee of the bridge for supported tokens from blockchain",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rosen-bridge/utils.git"
  },
  "license": "MIT",
  "author": "Rosen Team",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "scripts": {
    "prettify": "prettier --write . --ignore-path ../../../.gitignore",
    "prettify:check": "prettier --check . --ignore-path ../../../.gitignore",
    "lint": "eslint --fix . && npm run prettify",
    "lint:check": "eslint . && npm run prettify:check",
    "build": "tsc --build tsconfig.build.json",
    "type-check": "tsc --noEmit",
    "test": "jest --runInBand",
    "coverage": "npm run test -- --coverage",
    "release": "npm run test && npm run build && npm publish --access public"
  },
  "dependencies": {
    "@rosen-bridge/abstract-logger": "^3.0.1",
    "@rosen-bridge/json-bigint": "^1.1.0",
    "@rosen-clients/ergo-explorer": "^2.0.0",
    "@rosen-clients/ergo-node": "^3.0.0",
    "ergo-lib-wasm-nodejs": "^0.24.1"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.19.0",
    "@types/jest": "^29.1.2",
    "jest": "^29.2.0",
    "ts-jest": "^29.0.3"
  },
  "directories": {
    "lib": "lib",
    "test": "tests"
  },
  "keywords": [
    "rosen"
  ],
  "engines": {
    "node": ">=22.18.0"
  }
}
