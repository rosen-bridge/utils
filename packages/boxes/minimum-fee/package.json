    "ergo-lib-wasm-nodejs": "^0.24.1"
  },
  "devDependencies": {
    "@types/jest": "^29.1.2",
    "@types/node": "^20.11.0",
    "jest": "^29.2.0",
    "ts-jest": "^29.0.3",
    "ts-node": "^10.8.1",
    "@babel/preset-env": "^7.19.0",
    "typescript": "^5.8.3"
