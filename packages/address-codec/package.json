{
  "name": "@rosen-bridge/address-codec",
  "version": "1.1.0",
  "description": "A Typescript package for encoding and decoding of addresses in Rosen bridge supported chains",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rosen-bridge/utils.git"
  },
  "license": "MIT",
  "author": "Rosen Team",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc --build tsconfig.build.json",
    "coverage": "npm run test -- --run --coverage",
    "lint": "eslint --fix . && npm run prettify",
    "lint:check": "eslint . && npm run prettify:check",
    "prettify": "prettier --write . --ignore-path ../../.gitignore",
    "prettify:check": "prettier --check . --ignore-path ../../.gitignore",
    "release": "npm run test -- --run && npm run build && npm publish --access public",
    "test": "NODE_OPTIONS='--import tsx' vitest",
    "type-check": "tsc --noEmit"
  },
  "devDependencies": {
    "@vitest/coverage-istanbul": "^3.1.4",
    "tsx": "^4.20.5",
    "vitest": "^3.1.4"
  },
  "dependencies": {
    "@bitcoinerlab/secp256k1": "^1.2.0",
    "@emurgo/cardano-serialization-lib-nodejs": "^13.2.1",
    "bitcoinjs-lib": "^6.1.5",
    "ergo-lib-wasm-nodejs": "^0.24.1",
    "ethers": "6.16.0"
  },
  "engines": {
    "node": ">=22.18.0",
    "npm": "11.6.2"
  }
}
