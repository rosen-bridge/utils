{
  "name": "@rosen-bridge/fastify-enhanced",
  "version": "3.3.0",
  "description": "a wrapper around fastify web framework to make it even better",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rosen-bridge/utils.git"
  },
  "license": "MIT",
  "author": "Rosen Team",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc --build tsconfig.build.json",
    "coverage": "npm run test -- --run --coverage",
    "lint": "eslint --fix . && npm run prettify",
    "lint:check": "eslint . && npm run prettify:check",
    "prettify": "prettier --write . --ignore-path ../../.gitignore",
    "prettify:check": "prettier --check . --ignore-path ../../.gitignore",
    "release": "npm run test -- --run && npm run build && npm publish --access public",
    "test": "NODE_OPTIONS='--import tsx' vitest",
    "test:bin": "tsx tests/bin.ts",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/swagger": "^9.5.1",
    "@fastify/swagger-ui": "^5.2.3",
    "@rosen-bridge/abstract-logger": "^4.0.0",
    "fastify": "^5.3.3",
    "fastify-zod-openapi": "^4.1.2",
    "zod-openapi": "^4.2.4"
  },
  "devDependencies": {
    "zod": "^3.21.4"
  },
  "peerDependencies": {
    "zod": "^3.21.4"
  },
  "engines": {
    "node": ">=22.18.0",
    "npm": "11.6.2"
  }
}
