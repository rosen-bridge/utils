{
  "name": "@rosen-bridge/cli",
  "version": "2.1.2",
  "description": "The official Rosen bridge cli, providing helpers for the tasks related to Rosen bridge",
  "keywords": [
    "rosen"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rosen-bridge/utils.git"
  },
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "bin": "dist/index.js",
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc --build tsconfig.build.json",
    "lint": "eslint --fix . && npm run prettify",
    "lint:check": "eslint . && npm run prettify:check",
    "prettify": "prettier --write . --ignore-path ../../.gitignore",
    "prettify:check": "prettier --check . --ignore-path ../../.gitignore",
    "release": "npm run build && npm publish --access public",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@rosen-bridge/encryption": "^1.0.1",
    "@rosen-bridge/utils": "^2.0.2",
    "@zxcvbn-ts/core": "^3.0.4",
    "@zxcvbn-ts/language-common": "^3.0.4",
    "@zxcvbn-ts/language-en": "^3.0.2",
    "blakejs": "^1.2.1",
    "chalk": "^5.3.0",
    "ora": "^8.0.1",
    "tsx": "^4.20.5",
    "yargs": "^17.7.2"
  },
  "devDependencies": {
    "@types/yargs": "^17.0.33"
  },
  "engines": {
    "node": ">=22.18.0",
    "npm": "11.6.2"
  }
}
