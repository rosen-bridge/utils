{
  "name": "@rosen-bridge/extended-typeorm",
  "version": "0.1.0",
  "description": "An extended typeorm datasource with run some queries better",
  "main": "dist/lib/index.js",
  "types": "dist/lib/index.d.ts",
  "type": "module",
  "scripts": {
    "prettify": "prettier --write . --ignore-path .gitignore",
    "lint": "eslint --fix . && npm run prettify",
    "build": "tsc --build tsconfig.build.json",
    "type-check": "tsc --noEmit",
    "test": "jest --passWithNoTests --runInBand",
    "coverage": "jest --coverage --passWithNoTests --runInBand",
    "release": "npm run test && npm run build && npm publish --access public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rosen-bridge/utils.git"
  },
  "license": "GPL-3.0",
  "devDependencies": {
    "@babel/preset-env": "^7.19.0",
    "@types/jest": "^29.1.2",
    "@types/node": "^20.11.0",
    "jest": "^29.2.0",
    "ts-jest": "^29.0.3",
    "typescript": "^5.8.3"
  },
  "directories": {
    "lib": "lib",
    "test": "tests"
  },
  "keywords": [
    "rosen",
    "typeorm"
  ],
  "peerDependencies": {
    "sqlite3": "^5.1.6"
  },
  "dependencies": {
    "async-mutex": "^0.4.0",
    "typeorm": "^0.3.20"
  }
}
