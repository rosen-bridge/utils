{
  "name": "@rosen-bridge/tokens",
  "version": "3.1.1",
  "description": "this project manage supported tokens",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "scripts": {
    "prettify": "prettier --write . --ignore-path .gitignore",
    "lint": "eslint --fix . && npm run prettify",
    "build": "tsc --build tsconfig.build.json",
    "type-check": "tsc --noEmit",
    "test": "vitest",
    "coverage": "npm run test -- --run --coverage",
    "release": "npm run test -- --run && npm run build && npm publish --access public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rosen-bridge/utils.git"
  },
  "files": [
    "dist"
  ],
  "author": "Rosen Team",
  "license": "GPL-3.0",
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@vitest/coverage-istanbul": "^2.0.5",
    "ts-node": "^10.8.1",
    "typescript": "^5.8.3",
    "vitest": "^2.0.5"
  },
  "dependencies": {
    "@rosen-bridge/abstract-logger": "^2.0.1",
    "await-semaphore": "^0.1.3",
    "ergo-lib-wasm-nodejs": "^0.24.1"
  },
  "directories": {
    "lib": "lib",
    "test": "tests"
  },
  "keywords": [
    "rosen"
  ]
}
